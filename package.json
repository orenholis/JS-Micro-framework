{
  "name": "js-micro-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Lehký JavaScriptový framework pro výkonově omezená zařízení (bakalářská práce) a demonstrační samoobslužný kiosek.",
  "license": "MIT",
  "author": "Oren Holiš",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orenholis/JS-Micro-framework.git"
  },
  "keywords": [
    "framework",
    "ui",
    "signals",
    "kiosk",
    "no-build",
    "es-modules"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./svg": "./src/svg.js"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "format": "prettier \"{demo,tests}/**/*.{css,html}\" --write && eslint . --fix",
    "format:check": "prettier \"{demo,tests}/**/*.{css,html}\" --check",
    "lint": "eslint . && npm run format:check",
    "serve": "node tools/server.mjs",
    "test": "node tests/node-smoke.mjs && node tests/kiosk-state.mjs && node tests/catalog-api.mjs && node tests/server.mjs && node tests/kiosk-acceptance.mjs",
    "size": "npm run build --silent && node tools/size.mjs",
    "verify": "npm run lint && npm test && npm run size"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  }
}
